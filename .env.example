# --- Business Intelligence Sentinel Configuration ---

# ── Database ──────────────────────────────────────────────────────────────
# SQLite for local dev. For production, use Supabase PostgreSQL:
# DATABASE_URL=postgresql://user:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./sentinel.db

# ── LLM Configuration ────────────────────────────────────────────────────
# Set to true for local Ollama (dev), false for Groq API (prod)
USE_LOCAL_LLM=true
OLLAMA_MODEL=gemma3:1b

# Groq Cloud API Key — get free at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Deep Learning Models ──────────────────────────────────────────────────
FINBERT_MODEL=ProsusAI/finbert
ABSA_MODEL=yangheng/deberta-v3-base-absa-v1.1

# ── Data Source API Keys ──────────────────────────────────────────────────
# FRED API — free at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# NewsAPI — free dev tier at https://newsapi.org/register
NEWS_API_KEY=

# ── Email Delivery ────────────────────────────────────────────────────────
# Resend — free at https://resend.com (3,000 emails/month)
RESEND_API_KEY=
DELIVERY_EMAIL=recipient@example.com

# ── Watchlist Defaults ────────────────────────────────────────────────────
DEFAULT_TICKERS=AAPL,MSFT,GOOGL,NVDA,TSLA
DEFAULT_KEYWORDS=earnings,merger,acquisition,bankruptcy,FDA
DEFAULT_INDICATORS=GDP,CPIAUCSL,UNRATE,FEDFUNDS,DGS10,UMCSENT

# ── Scheduling ────────────────────────────────────────────────────────────
SCHEDULE_CRON=0 7 * * *
REPORT_TIMEZONE=Asia/Kolkata
